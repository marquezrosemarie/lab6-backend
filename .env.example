# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL_CA=

# Copy this file to .env, then run `php lava jwt:generate` to fill both keys.
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Set this to your deployed frontend origin before deploying the API.
API_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
